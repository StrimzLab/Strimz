# syntax=docker/dockerfile:1.7
#
# Single-container Strimz for AWS Lightsail (free-tier instance).
#
# Contains the full backend stack in one image so a Lightsail Nano
# instance can boot the whole platform with `docker run`. Not a shape
# I'd recommend for a real production deploy (postgres + redis want
# their own homes, and the co-located footprint fights bin-packing on
# any multi-tenant orchestrator), but perfect for the "give me a URL
# that hosts everything I built" demo we need for the Arc grant.
#
# What lives in the image:
#
#     nginx           :80          → reverse proxy fronts everything
#     apps/api        :4000        → NestJS/Fastify HTTP surface
#     apps/scheduler  :4200        → BullMQ cron worker + HTTP healthz
#     apps/agent      :4300        → AI cron worker + HTTP healthz
#     apps/indexer    :4100        → Go event indexer + /healthz
#     postgres        :5432        → local DB (volume-persisted)
#     redis           :6379        → local Redis (volume-persisted)
#     supervisord                  → orchestrates all of the above
#
# Data survives container restarts via the `/data` volume mount:
#
#     docker run -v strimz-data:/data ...
#
# Build:   docker build -f Dockerfile.lightsail -t strimz:latest .
# Run:     see infra/lightsail/deploy.sh + infra/lightsail/README.md

# ============================================================
# Stage 1 — Node builder. Turbo + pnpm run the workspace build.
# ============================================================
FROM node:22-alpine AS node-build

WORKDIR /repo

# Toolchain for native builds (Prisma engines, sharp).
RUN apk add --no-cache python3 make g++ git bash curl \
 && corepack enable

# Copy manifests first so the pnpm install layer caches on unchanged deps.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY packages ./packages
COPY apps/api/package.json ./apps/api/
COPY apps/scheduler/package.json ./apps/scheduler/
COPY apps/agent/package.json ./apps/agent/

# Warm the store. `--frozen-lockfile` matches CI.
RUN pnpm install --frozen-lockfile

# Bring in source + build every package the API/scheduler/agent depend on,
# then the three services themselves. Prisma client is generated inside
# the @strimz/db build.
COPY apps/api ./apps/api
COPY apps/scheduler ./apps/scheduler
COPY apps/agent ./apps/agent
# Exclude @strimz/contracts — its build is `forge build`, and there is no
# Foundry in this Node image. Nothing at runtime depends on it (ABIs are
# hand-maintained in the services), so it never needs to compile here.
RUN pnpm --filter "./packages/*" --filter '!@strimz/contracts' build \
 && pnpm --filter @strimz/db exec prisma generate \
 && pnpm --filter @strimz/api build \
 && pnpm --filter @strimz/scheduler build \
 && pnpm --filter @strimz/agent build

# =====================================================
# Stage 2 — Go builder for the on-chain indexer binary.
# =====================================================
FROM golang:1.25-alpine AS indexer-build

WORKDIR /src
COPY apps/indexer/go.mod apps/indexer/go.sum ./
RUN go mod download

COPY apps/indexer/ ./
# CGO off gives us a fully static binary that runs on the alpine
# runtime image without dragging musl-libc-vs-glibc surprises.
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath -ldflags="-s -w" \
    -o /out/strimz-indexer \
    ./cmd/indexer

# ==========================================================
# Stage 3 — Runtime. Alpine + Node + PG + Redis + Nginx + s6.
# ==========================================================
FROM node:22-alpine AS runtime

WORKDIR /repo

# Everything the container needs at boot:
#   - postgresql16 / redis: co-located data plane
#   - nginx: front-door reverse proxy
#   - supervisor: keeps all processes alive + restarts on crash
#   - su-exec + tini: privilege-drop + PID 1 reaping
#   - bash / curl: entrypoint script + healthcheck
RUN apk add --no-cache \
      postgresql16 postgresql16-contrib \
      redis \
      nginx \
      supervisor \
      su-exec tini \
      bash curl \
 && corepack enable

# Copy the built workspace. Includes node_modules (pnpm's virtual store),
# every package's dist/, and the Prisma client the runtime needs.
COPY --from=node-build /repo /repo

# Copy the Go indexer binary onto PATH.
COPY --from=indexer-build /out/strimz-indexer /usr/local/bin/strimz-indexer

# Infra configs live under /infra so an operator debugging the container
# can `docker exec` in and read them without hunting.
COPY infra/lightsail/supervisord.conf /etc/supervisord.conf
COPY infra/lightsail/nginx.conf       /etc/nginx/nginx.conf
COPY infra/lightsail/entrypoint.sh    /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Data volume. Postgres + Redis both live under /data so a single
# volume mount preserves everything across container restarts.
RUN mkdir -p /data/postgres /data/redis \
             /var/log/supervisor \
             /run/postgresql \
             /var/log/nginx \
 && chown -R postgres:postgres /data/postgres /run/postgresql \
 && chown -R redis:redis /data/redis
VOLUME /data

# Only port 80 crosses the container boundary. Nginx front-doors to the
# api on :4000; scheduler/agent/indexer stay internal.
EXPOSE 80

# tini reaps zombies + forwards signals cleanly. entrypoint.sh handles
# first-boot init (postgres initdb, migrations), then hands off to
# supervisord which owns every process for the container's lifetime.
ENTRYPOINT ["/sbin/tini", "--", "/entrypoint.sh"]
