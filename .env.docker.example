# Override the docker-compose defaults from your shell.
#
# Copy to `.env` at the repo root (NOT inside an app dir) — Compose
# reads it automatically and substitutes `${VAR}` references.
#
# Most local-dev users don't need to touch any of this. The defaults
# baked into docker-compose.yml work as long as you're using the
# postgres / redis / anvil services from the same compose file.

# ─────────── Local DB / Redis hostnames ───────────
# When running `pnpm dev` from your host shell, point the apps at
# localhost (the published compose ports). When running inside the
# `full` profile, the compose env block already overrides these to
# the service names (`postgres`, `redis`, `anvil`).
#
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strimz?schema=public
# REDIS_URL=redis://localhost:6379
# ARC_RPC_URL=http://localhost:8545

# ─────────── Postgres credentials ───────────
# Override only if you need non-default creds for some reason.
#
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=strimz
