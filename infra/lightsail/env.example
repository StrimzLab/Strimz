# Strimz single-container env.
#
# ALL backend services (api, scheduler, agent, indexer) read from the
# container's process env. Variables with the same name (DATABASE_URL,
# REDIS_URL, ARC_*, RESEND_*) resolve identically across every service
# — one file describes the whole platform.
#
# Copy to `.env` next to your deploy script, fill in the placeholders,
# and pass with `docker run --env-file .env ...`.

# ---- Runtime ----
NODE_ENV=production
LOG_LEVEL=info
# Set to false to skip the optional AI agent process and free ~120 MB of RAM
# on a memory-tight (1 GB) instance. Core billing does not need it.
ENABLE_AGENT=true

# ---- Local data plane (already inside the container) ----
DATABASE_URL=postgresql://postgres@localhost:5432/strimz?schema=public
REDIS_URL=redis://localhost:6379

# ---- Arc chain ----
ARC_ENVIRONMENT=testnet
ARC_CHAIN_ID=5042002
# API and scheduler: ARC_RPC_URL, then each fallback in order when it errors.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_FALLBACK_RPC_URLS=https://rpc.quicknode.testnet.arc.io,https://rpc.blockdaemon.testnet.arc.io
# Indexer: its own endpoints, replacing the two above when set. Each must answer
# eth_getLogs over BLOCK_BATCH_SIZE blocks, or the indexer won't start. Free keyed
# RPCs (Alchemy, QuickNode, dRPC) cap it at 5-100 blocks (ADR-2026-11-22-rpc-per-service).
# Mainnet: ARC_RPC_URL=<Alchemy>, ARC_FALLBACK_RPC_URLS=<QuickNode>,https://rpc.mainnet.arc.io,
# INDEXER_ARC_RPC_URL=https://rpc.mainnet.arc.io
INDEXER_ARC_RPC_URL=
INDEXER_FALLBACK_RPC_URLS=
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# ---- Strimz contract deployment (testnet) ----
STRIMZ_REGISTRY_ADDRESS=0xe834cde9324feb2093e3f37a2d9fff84e53302f3
STRIMZ_TOKEN_WHITELIST_ADDRESS=0x9e6a9e46af57a8ae46ddbafd1779f040cf9c914a
# Agent contracts: testnet only. Leave both agent addresses empty on mainnet
# (ADR-2026-11-23-mainnet-without-agent-escrow).
AGENT_REGISTRY_ADDRESS=0x7c6c2bae78f73424311d7030e0a960dcc4ea2235
# The TimelockController from the admin handoff. Mainnet only: testnet has none.
TIMELOCK_ADDRESS=
STRIMZ_FEE_COLLECTOR_ADDRESS=0xb80cc20dd0f492fac4d72ccc830eaa9909a215f2
STRIMZ_PAYMENTS_ADDRESS=0xe3d4b6591eed2871958bedf6a4ff1494d0e9e879
STRIMZ_SUBSCRIPTIONS_ADDRESS=0xaab095021a4644fa81096cead26ed484ad855b24
# Indexer needs the same, minus the STRIMZ_ prefix.
REGISTRY_ADDRESS=0xe834cde9324feb2093e3f37a2d9fff84e53302f3
PAYMENTS_ADDRESS=0xe3d4b6591eed2871958bedf6a4ff1494d0e9e879
SUBSCRIPTIONS_ADDRESS=0xaab095021a4644fa81096cead26ed484ad855b24
AGENT_ESCROW_ADDRESS=0x4ae0f38713f88d818fa76f46dc31ff52acadce9e
FEE_COLLECTOR_ADDRESS=0xb80cc20dd0f492fac4d72ccc830eaa9909a215f2
TOKEN_WHITELIST_ADDRESS=0x9e6a9e46af57a8ae46ddbafd1779f040cf9c914a
STABLECOIN_ADDRESSES=USDC:0x3600000000000000000000000000000000000000,EURC:0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
# Arc: sub-second blocks, deterministic finality (no reorgs).
POLL_INTERVAL_MS=1000
CONFIRMATIONS=1
# Block the core contracts were deployed at — nothing to scan before it.
START_BLOCK=74376690
BLOCK_BATCH_SIZE=500

# ---- API-facing surface ----
API_BASE_URL=https://api.strimz.finance
# The frontends run on Cloudflare Workers (docs/runbooks/cloudflare-workers.md).
CHECKOUT_ORIGIN=https://checkout.strimz.finance
CORS_ORIGIN=https://strimz.finance,https://app.strimz.finance,https://admin.strimz.finance,https://checkout.strimz.finance

# ---- Auth: Privy (merchant dashboard) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Auth: Cloudflare Turnstile (signup bot check) ----
TURNSTILE_SECRET_KEY=

# ---- Webhook signing + secret encryption (must match across services) ----
STRIMZ_WEBHOOK_SIGNING_SECRET=
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=Strimz <noreply@mail.your-domain.com>
RESEND_REPLY_TO=you@your-domain.com
STRIMZ_ADMIN_ALERT_EMAIL=you@your-domain.com
OPS_ALERT_EMAIL=you@your-domain.com
STRIMZ_DASHBOARD_URL=https://app.strimz.finance
STRIMZ_ADMIN_URL=https://admin.strimz.finance

# ---- Signing keys (relayer and scheduler) ----
# Testnet: plain keys, allowed in production only with ARC_ENVIRONMENT=testnet
# (ADR-2026-11-13-testnet-software-signer). Each key needs its on-chain role and
# USDC for gas. The two keys must differ. Keep this file mode 600, owned by root.
KMS_PROVIDER=software
KMS_SOFTWARE_PRIVATE_KEY=
SCHEDULER_SIGNER_PROVIDER=software
SCHEDULER_PRIVATE_KEY=
# The relayer key's address.
RELAYER_ADDRESS=
# Mainnet signs only with Privy server wallets (ADR-2026-11-22-privy-server-signers,
# docs/runbooks/privy-signers.md). Leave every plain key above empty and set:
# KMS_PROVIDER=privy
# SCHEDULER_SIGNER_PROVIDER=privy
# REFUND_SIGNER_PROVIDER=privy
# PRIVY_RELAYER_WALLET_ID=
# KMS_SIGNER_ADDRESS=
# PRIVY_SCHEDULER_WALLET_ID=
# SCHEDULER_SIGNER_ADDRESS=
# PRIVY_REFUND_WALLET_ID=
# REFUND_SIGNER_ADDRESS=
# The server's Privy key ("Strimz mainnet signer"). Never the owner key.
# PRIVY_SIGNER_AUTHORIZATION_KEY=
# RELAY_PLATFORM_DAILY_CAP=1500

# ---- Compliance ----
COMPLIANCE_PROVIDER=disabled
COMPLIANCE_API_KEY=

# ---- Circle attestation (Sandbox) ----
CIRCLE_ATTESTATION_BASE_URL=https://iris-api-sandbox.circle.com
CIRCLE_API_KEY=

# ---- Optional ----
SENTRY_DSN=
