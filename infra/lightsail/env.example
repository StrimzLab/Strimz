# Strimz single-container env.
#
# ALL backend services (api, scheduler, agent, indexer) read from the
# container's process env. Variables with the same name (DATABASE_URL,
# REDIS_URL, ARC_*, RESEND_*) resolve identically across every service
# — one file describes the whole platform.
#
# Copy to `.env` next to your deploy script, fill in the placeholders,
# and pass with `docker run --env-file .env ...`.

# ---- Runtime ----
NODE_ENV=production
LOG_LEVEL=info
# Set to false to skip the optional AI agent process and free ~120 MB of RAM
# on a memory-tight (1 GB) instance. Core billing does not need it.
ENABLE_AGENT=true

# ---- Local data plane (already inside the container) ----
DATABASE_URL=postgresql://postgres@localhost:5432/strimz?schema=public
REDIS_URL=redis://localhost:6379

# ---- Arc chain ----
ARC_ENVIRONMENT=testnet
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.io
# Ordered fallbacks tried when ARC_RPC_URL errors. getLogs-capable providers only.
ARC_FALLBACK_RPC_URLS=https://rpc.quicknode.testnet.arc.io,https://rpc.drpc.testnet.arc.io,https://rpc.blockdaemon.testnet.arc.io
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# ---- Strimz contract deployment (testnet) ----
STRIMZ_REGISTRY_ADDRESS=0xac3c2632457d76c3752907add8dad06afa7ce681
STRIMZ_TOKEN_WHITELIST_ADDRESS=0xd857043f2d1d96b53e096e175605907507b2b853
AGENT_REGISTRY_ADDRESS=0x4ede74db581de6c31138a6145b7a62f99527b3ca
TIMELOCK_ADDRESS=0x2cdbaf2dcdb2128422edb10d1b81f7eb8d95066d
STRIMZ_FEE_COLLECTOR_ADDRESS=0x20b8461c268f000c6c62a1dd313e8eb511fe2920
STRIMZ_PAYMENTS_ADDRESS=0xac238787c7b1375529c48274dc382868dd26f3aa
STRIMZ_SUBSCRIPTIONS_ADDRESS=0x5b1aca9f3a4a75952d60e9db5bb8617737916104
# Indexer needs the same, minus the STRIMZ_ prefix.
REGISTRY_ADDRESS=0xac3c2632457d76c3752907add8dad06afa7ce681
PAYMENTS_ADDRESS=0xac238787c7b1375529c48274dc382868dd26f3aa
SUBSCRIPTIONS_ADDRESS=0x5b1aca9f3a4a75952d60e9db5bb8617737916104
AGENT_ESCROW_ADDRESS=0x02a0ceb2d93224e5f3e775b22e30c0241591cccf
FEE_COLLECTOR_ADDRESS=0x20b8461c268f000c6c62a1dd313e8eb511fe2920
TOKEN_WHITELIST_ADDRESS=0xd857043f2d1d96b53e096e175605907507b2b853
STABLECOIN_ADDRESSES=USDC:0x3600000000000000000000000000000000000000,EURC:0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
# Arc: sub-second blocks, deterministic finality (no reorgs).
POLL_INTERVAL_MS=1000
CONFIRMATIONS=1
# Block the core contracts were deployed at — nothing to scan before it.
START_BLOCK=71161770
BLOCK_BATCH_SIZE=500

# ---- API-facing surface ----
API_BASE_URL=http://your-lightsail-hostname
# The hosted checkout is served by the web app on Vercel, not this box.
CHECKOUT_ORIGIN=https://www.strimz.finance
CORS_ORIGIN=http://your-lightsail-hostname

# ---- Auth: Privy (merchant dashboard) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Auth: Cloudflare Turnstile (signup bot check) ----
TURNSTILE_SECRET_KEY=

# ---- Webhook signing + secret encryption (must match across services) ----
STRIMZ_WEBHOOK_SIGNING_SECRET=
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=Strimz <noreply@mail.your-domain.com>
RESEND_REPLY_TO=you@your-domain.com
STRIMZ_ADMIN_ALERT_EMAIL=you@your-domain.com
OPS_ALERT_EMAIL=you@your-domain.com
STRIMZ_DASHBOARD_URL=http://your-lightsail-hostname

# ---- KMS / relayer signing key ----
KMS_PROVIDER=aws-kms
KMS_AWS_KEY_ID=alias/strimz-testnet-relayer
KMS_SIGNER_ADDRESS=
# Same private key gives the scheduler its distinct signing identity
# in the free-tier demo. In prod, use a separate one.
SCHEDULER_SIGNER_PROVIDER=aws-kms
SCHEDULER_KMS_KEY_ID=alias/strimz-testnet-scheduler
SCHEDULER_SIGNER_ADDRESS=
RELAYER_ADDRESS=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Compliance ----
COMPLIANCE_PROVIDER=disabled
COMPLIANCE_API_KEY=

# ---- Circle attestation (Sandbox) ----
CIRCLE_ATTESTATION_BASE_URL=https://iris-api-sandbox.circle.com
CIRCLE_API_KEY=

# ---- Optional ----
SENTRY_DSN=
