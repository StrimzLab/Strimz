# Strimz single-container env.
#
# ALL backend services (api, scheduler, agent, indexer) read from the
# container's process env. Variables with the same name (DATABASE_URL,
# REDIS_URL, ARC_*, RESEND_*) resolve identically across every service
# — one file describes the whole platform.
#
# Copy to `.env` next to your deploy script, fill in the placeholders,
# and pass with `docker run --env-file .env ...`.

# ---- Runtime ----
NODE_ENV=production
LOG_LEVEL=info
# Set to false to skip the optional AI agent process and free ~120 MB of RAM
# on a memory-tight (1 GB) instance. Core billing does not need it.
ENABLE_AGENT=false

# ---- Local data plane (already inside the container) ----
DATABASE_URL=postgresql://postgres@localhost:5432/strimz?schema=public
REDIS_URL=redis://localhost:6379

# ---- Arc chain ----
ARC_ENVIRONMENT=testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
# Ordered fallbacks tried when ARC_RPC_URL errors. getLogs-capable providers only.
ARC_FALLBACK_RPC_URLS=https://rpc.quicknode.testnet.arc.network,https://rpc.drpc.testnet.arc.network,https://rpc.blockdaemon.testnet.arc.network
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# ---- Strimz contract deployment (testnet) ----
STRIMZ_REGISTRY_ADDRESS=0x23bb25315107bf7463a84913eccd450a43f71ae3
STRIMZ_TOKEN_WHITELIST_ADDRESS=0xc907412e31a35fcfac9336285a34c0007425066c
STRIMZ_FEE_COLLECTOR_ADDRESS=0x1ab0e7f7c787b9474488e615096ec3e1bae5cfe2
STRIMZ_PAYMENTS_ADDRESS=0x2dfa72f9564bdfeb1b32e77c2fdf7040c69bdc7b
STRIMZ_SUBSCRIPTIONS_ADDRESS=0xed374f8b4d22361d2487404de34224f74f85fb4c
# Indexer needs the same, minus the STRIMZ_ prefix.
REGISTRY_ADDRESS=0x23bb25315107bf7463a84913eccd450a43f71ae3
PAYMENTS_ADDRESS=0x2dfa72f9564bdfeb1b32e77c2fdf7040c69bdc7b
SUBSCRIPTIONS_ADDRESS=0xed374f8b4d22361d2487404de34224f74f85fb4c
AGENT_ESCROW_ADDRESS=0x3e3407650c22cd982d36c429d262403106f49b1e
FEE_COLLECTOR_ADDRESS=0x1ab0e7f7c787b9474488e615096ec3e1bae5cfe2
STABLECOIN_ADDRESSES=${ARC_USDC_ADDRESS}
# Arc: sub-second blocks, deterministic finality (no reorgs).
POLL_INTERVAL_MS=1000
CONFIRMATIONS=1
# Block the core contracts were deployed at — nothing to scan before it.
START_BLOCK=51147731
BLOCK_BATCH_SIZE=500

# ---- API-facing surface ----
API_BASE_URL=http://your-lightsail-hostname
CHECKOUT_ORIGIN=http://your-lightsail-hostname
CORS_ORIGIN=http://your-lightsail-hostname

# ---- Auth: Privy (merchant dashboard) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Auth: Cloudflare Turnstile (signup bot check) ----
TURNSTILE_SECRET_KEY=

# ---- Webhook signing + secret encryption (must match across services) ----
STRIMZ_WEBHOOK_SIGNING_SECRET=
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=Strimz <noreply@mail.your-domain.com>
RESEND_REPLY_TO=you@your-domain.com
STRIMZ_ADMIN_ALERT_EMAIL=you@your-domain.com
STRIMZ_DASHBOARD_URL=http://your-lightsail-hostname

# ---- KMS / relayer signing key ----
KMS_PROVIDER=software
KMS_SOFTWARE_PRIVATE_KEY=
# Same private key gives the scheduler its distinct signing identity
# in the free-tier demo. In prod, use a separate one.
SCHEDULER_PRIVATE_KEY=
RELAYER_ADDRESS=

# ---- Compliance ----
COMPLIANCE_PROVIDER=disabled
COMPLIANCE_API_KEY=

# ---- Circle attestation (Sandbox) ----
CIRCLE_ATTESTATION_BASE_URL=https://iris-api-sandbox.circle.com
CIRCLE_API_KEY=

# ---- Optional ----
SENTRY_DSN=
