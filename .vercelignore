# Applies to Vercel CLI deploys that upload the monorepo root (e.g. the
# demo-merchant deploy). Vercel already skips node_modules / .git / .vercel.
#
# IMPORTANT: do NOT exclude any apps/* or packages/* SOURCE directories.
# The build runs `pnpm install --frozen-lockfile` at the root, which needs
# every workspace member present or the install fails. Only exclude things
# that are regenerated during the build or must never leave your machine.

# Local secrets — Vercel uses its own dashboard env vars, never these.
**/.env
**/.env.*
!**/.env.example

# Build artifacts — regenerated by the build, just bloat the upload.
**/.next
**/.turbo
**/dist
**/out
**/generated

# Foundry / chain outputs irrelevant to the web build.
packages/contracts/out
packages/contracts/cache
packages/contracts/broadcast
