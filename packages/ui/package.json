{
  "name": "@strimz/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared shadcn/ui primitives configured with Strimz brand tokens. Distributed as source; consuming apps compile Tailwind.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./globals.css": "./src/styles/globals.css",
    "./cn": {
      "types": "./src/lib/cn.ts",
      "import": "./src/lib/cn.ts",
      "default": "./src/lib/cn.ts"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "import": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./providers/*": {
      "types": "./src/providers/*.tsx",
      "import": "./src/providers/*.tsx",
      "default": "./src/providers/*.tsx"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next-themes": "^0.4.4",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.1.3",
    "@radix-ui/react-accordion": "^1.2.12"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.9.1 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.54.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@strimz/eslint-config": "workspace:*",
    "@strimz/tsconfig": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.54.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
