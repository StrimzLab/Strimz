{
  "name": "@strimz/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Strimz smart contracts — registry, payments, subscriptions, fees, and AI agent escrow. Foundry workspace.",
  "license": "MIT",
  "scripts": {
    "build": "arc-forge build",
    "test": "arc-forge clean && arc-forge build && arc-forge test --network arc -vv",
    "test:fork": "FOUNDRY_PROFILE=fork arc-forge test --network arc -vv",
    "test:gas": "arc-forge test --network arc --gas-report",
    "format": "arc-forge fmt",
    "clean": "arc-forge clean && rm -rf .turbo out-fork cache-fork",
    "coverage": "arc-forge coverage --network arc --report lcov",
    "snapshot": "arc-forge snapshot --network arc",
    "forge:install": "arc-forge install foundry-rs/forge-std OpenZeppelin/openzeppelin-contracts@v5.6.1 OpenZeppelin/openzeppelin-contracts-upgradeable@v5.6.1 OpenZeppelin/openzeppelin-foundry-upgrades",
    "deploy:testnet": "arc-forge script script/DeployCore.s.sol:DeployCore --network arc --rpc-url $ARC_TESTNET_RPC_URL --broadcast --verify",
    "deploy:agent:testnet": "arc-forge script script/DeployAgent.s.sol:DeployAgent --network arc --rpc-url $ARC_TESTNET_RPC_URL --broadcast"
  },
  "devDependencies": {
    "@openzeppelin/upgrades-core": "^1.46.0"
  }
}
