{
  "name": "@strimz/shared-config",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of truth for chain definitions, token registry, fee tiers, webhook events, and agent flags.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./chains": {
      "types": "./dist/chains.d.ts",
      "import": "./dist/chains.js",
      "require": "./dist/chains.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./tiers": {
      "types": "./dist/tiers.d.ts",
      "import": "./dist/tiers.js",
      "require": "./dist/tiers.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    },
    "./api-keys": {
      "types": "./dist/api-keys.d.ts",
      "import": "./dist/api-keys.js",
      "require": "./dist/api-keys.cjs"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js",
      "require": "./dist/agents.cjs"
    },
    "./cctp": {
      "types": "./dist/cctp.d.ts",
      "import": "./dist/cctp.js",
      "require": "./dist/cctp.cjs"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "viem": "^2.22.6"
  },
  "devDependencies": {
    "@strimz/eslint-config": "workspace:*",
    "@strimz/tsconfig": "workspace:*",
    "eslint": "^9.18.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
