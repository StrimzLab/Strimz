{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Strimz NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    // Every NestJS app in the repo (api, scheduler, agent) declares
    // "type": "module" in package.json. CommonJS emit would mismatch
    // and fail at runtime with "exports is not defined". Node16
    // resolution is the format Node 22+ runs natively.
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "verbatimModuleSyntax": false,
    "strictPropertyInitialization": false
  }
}
