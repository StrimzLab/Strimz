{
  "name": "@strimz/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema and generated client for the Strimz platform — every on-chain-backed and off-chain entity.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js",
      "default": "./dist/src/client.js"
    }
  },
  "files": [
    "dist",
    "src",
    "prisma",
    "generated",
    "README.md"
  ],
  "scripts": {
    "db:generate": "prisma generate && node scripts/strip-ts-nocheck.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "build": "prisma generate && node scripts/strip-ts-nocheck.mjs && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist generated .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@strimz/eslint-config": "workspace:*",
    "@strimz/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.18.0",
    "prisma": "^7.0.0",
    "typescript": "^5.7.3"
  }
}
