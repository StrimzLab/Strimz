/// Off-chain job lifecycle. Deliberately NOT a 1:1 mirror of the
/// contract's JobStatus: `accepted` is off-chain only (approved by the
/// merchant, queued for on-chain creation) and has no on-chain
/// counterpart. `funded`, `resolved` and `reclaimed` mirror the escrow's
/// states — `resolved` (arbitrated split) and `reclaimed` (timeout
/// recovery) are the escrow's only exits from a dispute or an abandoned
/// job, so without them such jobs never reach a terminal status.
enum AgentJobStatus {
  proposed
  accepted
  funded
  in_progress
  delivered
  approved
  completed
  disputed
  cancelled
  resolved
  reclaimed
}

