/// One value per contract ChargeOutcome. Previously every non-billing
/// outcome collapsed into `skipped`, which made it impossible to tell a
/// retryable failure from a terminal one — or to measure whether charges
/// were being dropped at all. `skipped` remains as the fallback for
/// outcomes a future contract appends.
enum SubscriptionChargeOutcome {
  charged
  insufficient_funds
  revoked_approval
  cancelled
  not_due
  ended
  duplicate
  unknown
  merchant_inactive
  transfer_failed
  skipped
}

