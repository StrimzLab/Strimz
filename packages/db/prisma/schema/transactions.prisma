// Confirmed on-chain transaction records.
// The indexer writes these by projecting contract events.

model Transaction {
  id                     String             @id @default(cuid())
  merchantId             String
  kind                   TransactionKind
  status                 TransactionStatus  @default(pending)

  // One of these is set depending on `kind`.
  sessionId              String?            @unique
  subscriptionId         String?
  subscriptionChargeId   String?            @unique
  refundId               String?            @unique
  customerId             String?

  amount                 String             @db.VarChar(78)
  feeAmount              String             @db.VarChar(78)
  netAmount              String             @db.VarChar(78)
  currency               PaymentCurrency

  payerAddress           String             @db.VarChar(42)
  merchantAddress        String             @db.VarChar(42)

  onchainTxHash          String             @db.VarChar(66)
  blockNumber            BigInt
  blockTimestamp         DateTime
  logIndex               Int

  mode                   Mode               @default(test)

  createdAt              DateTime           @default(now())

  merchant               Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  session                PaymentSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  subscription           Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionCharge     SubscriptionCharge? @relation(fields: [subscriptionChargeId], references: [id], onDelete: SetNull)
  refund                 Refund?            @relation(fields: [refundId], references: [id], onDelete: SetNull)
  customer               Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  feeRefund              FeeRefund?

  @@unique([onchainTxHash, logIndex])
  @@index([onchainTxHash])
  @@index([merchantId, kind, blockTimestamp])
  @@index([merchantId, status])
  @@index([merchantId, mode, status, blockTimestamp])
  @@index([merchantId, mode, blockTimestamp])
  @@index([customerId])
  @@index([payerAddress])
  @@index([blockNumber])
}

/// The fee on one payment that Strimz pays back because it fell inside the
/// business's free allowance (ADR-2026-11-21-free-plan-fee-integrity).
model FeeRefund {
  id            String          @id @default(cuid())
  merchantId    String
  /// Unique, so a payment's fee is refunded at most once.
  transactionId String          @unique
  currency      PaymentCurrency
  amount        String          @db.VarChar(78)
  mode          Mode
  status        FeeRefundStatus @default(pending)
  transferId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  merchant      Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction   Transaction        @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  transfer      FeeRefundTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@index([status, mode])
  @@index([merchantId])
}

/// One token transfer from the refund wallet. Signed and stored before it is
/// broadcast, so a restart rebroadcasts the same transaction instead of paying twice.
model FeeRefundTransfer {
  id          String                  @id @default(cuid())
  merchantId  String
  currency    PaymentCurrency
  amount      String                  @db.VarChar(78)
  toAddress   String                  @db.VarChar(42)
  fromAddress String                  @db.VarChar(42)
  nonce       Int
  txHash      String                  @unique @db.VarChar(66)
  signedTx    String
  status      FeeRefundTransferStatus @default(signed)
  mode        Mode
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  refunds     FeeRefund[]

  @@unique([fromAddress, nonce])
  @@index([status])
}
