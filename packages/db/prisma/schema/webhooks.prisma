// Webhook endpoints, events, and delivery attempts.
//
// Event   = the thing that happened (immutable).
// Delivery = one attempt to POST a specific event to a specific endpoint.

model MerchantWebhookEndpoint {
  id                      String                @id @default(cuid())
  merchantId              String
  mode                    Mode
  url                     String
  description             String?               @db.VarChar(200)
  events                  WebhookEventName[]
  status                  WebhookEndpointStatus @default(active)
  /// sha256(signingSecret). Used as the integrity-check index; cannot
  /// recover the plaintext.
  signingSecretHash       String
  /// AES-256-GCM ciphertext of the plaintext signing secret, encoded
  /// `v1:<nonce-hex>:<ciphertext-and-tag-hex>`. Decrypted by the
  /// scheduler at boot to warm the Redis cache the delivery worker
  /// reads from. Nullable for backward compatibility with endpoints
  /// created before #71 — those need a rotation to populate the
  /// column and the merchant dashboard surfaces the prompt.
  signingSecretCiphertext String?
  signingSecretPrefix     String                @db.VarChar(12)
  lastDeliveredAt         DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  merchant   Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@index([merchantId, mode, status])
}

model WebhookEvent {
  id           String              @id @default(cuid())
  merchantId   String
  type         WebhookEventName
  apiVersion   String              @db.VarChar(10)
  mode         Mode
  /// The delivered envelope. Producers that build it inline (apps/api)
  /// store the final shape here. Producers that only know entity ids at
  /// write time (the Go indexer) store a `{ ref: {...} }` marker that the
  /// scheduler outbox dispatcher hydrates into the final envelope.
  payload      Json
  /// Set when the outbox dispatcher has created deliveries + enqueued
  /// jobs for this event. Null = not yet dispatched (the dispatcher's
  /// claim target). Inline producers stamp it at write time.
  dispatchedAt DateTime?
  /// Last dispatch error (schema-validation / hydration failure). Non-null
  /// means the event is quarantined and needs a code fix + manual redispatch.
  dispatchError String?            @db.VarChar(1000)
  createdAt    DateTime            @default(now())

  merchant   Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@index([merchantId, type, createdAt])
  @@index([merchantId, mode, createdAt])
  @@index([dispatchedAt])
}

model WebhookDelivery {
  id            String                @id @default(cuid())
  /// Opaque idempotency key sent in the X-Strimz-Delivery-Id header.
  deliveryId    String                @unique
  merchantId    String
  endpointId    String
  eventId       String
  eventName     WebhookEventName
  status        WebhookDeliveryStatus @default(pending)
  attempt       Int                   @default(1)
  responseCode  Int?
  responseMs    Int?
  responseBody  String?               @db.Text
  lastError     String?               @db.VarChar(1000)
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())

  merchant Merchant                @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  endpoint MerchantWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  event    WebhookEvent            @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([merchantId, createdAt])
  @@index([eventId])
}
