// Subscription plans, active subscriptions, and individual charges.

model SubscriptionPlan {
  id               String                 @id @default(cuid())
  merchantId       String
  name             String                 @db.VarChar(120)
  description      String?                @db.VarChar(500)
  amount           String                 @db.VarChar(78)
  currency         PaymentCurrency
  interval         SubscriptionInterval
  intervalCount    Int                    @default(1)
  trialPeriodDays  Int?
  status           SubscriptionPlanStatus @default(active)
  metadata         Json                   @default("{}")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  merchant         Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  subscriptions    Subscription[]

  @@index([merchantId, status])
}

model Subscription {
  id                      String              @id @default(cuid())
  onchainSubscriptionId   Int?                @unique
  /// On-chain tx hash for the `permitAndCreateSubscription` call that
  /// enrolled this subscription. Distinct from per-period charge tx
  /// hashes (those live on SubscriptionCharge). Used by the relay's
  /// double-enrolment safety net and surfaced on the hosted checkout's
  /// "Subscription active" view.
  enrolmentTxHash         String?             @unique @db.VarChar(66)
  merchantId              String
  customerId              String
  planId                  String
  status                  SubscriptionStatus  @default(active)

  payerAddress            String              @db.VarChar(42)
  currency                PaymentCurrency
  amount                  String              @db.VarChar(78)
  interval                SubscriptionInterval
  intervalCount           Int                 @default(1)

  trialEndsAt             DateTime?
  currentPeriodStartAt    DateTime
  currentPeriodEndAt      DateTime
  nextChargeAt            DateTime?
  gracePeriodHours        Int                 @default(48)

  /// Soft lock used by the scheduler to prevent concurrent charge attempts.
  chargeLock              Boolean             @default(false)
  chargeLockAcquiredAt    DateTime?

  cancelledAt             DateTime?
  cancellationReason      String?             @db.VarChar(500)

  mode                    Mode                @default(test)
  metadata                Json                @default("{}")
  /// Timestamp the scheduler sent the "new subscriber" email to the
  /// merchant. Null until the notification cron picks the row up;
  /// guarantees one-shot delivery without a separate event log.
  merchantNotifiedAt      DateTime?
  /// Payer-side enrolment receipt one-shot stamp.
  customerNotifiedAt      DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  merchant                Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  customer                Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan                    SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  charges                 SubscriptionCharge[]
  transactions            Transaction[]

  @@index([merchantId, status])
  @@index([nextChargeAt, status])
  @@index([customerId])
  @@index([customerNotifiedAt])
}

model SubscriptionCharge {
  id                String                    @id @default(cuid())
  subscriptionId    String
  merchantId        String

  /// 32-byte contract-idempotency key carried on the charge call.
  chargeAttemptId   String                    @unique @db.VarChar(66)

  periodStartAt     DateTime
  periodEndAt       DateTime
  amount            String                    @db.VarChar(78)
  currency          PaymentCurrency

  status            SubscriptionChargeStatus  @default(pending)
  outcome           SubscriptionChargeOutcome?
  attemptNumber     Int                       @default(1)

  scheduledAt       DateTime
  executedAt        DateTime?
  onchainTxHash     String?                   @db.VarChar(66)
  failureReason     String?                   @db.VarChar(500)

  /// Timestamp the scheduler sent the "recurring charge succeeded"
  /// email to the merchant. Only stamped after `status = succeeded`.
  /// Null = un-notified; cron picks it up. Same one-shot pattern as
  /// `Subscription.merchantNotifiedAt`.
  merchantNotifiedAt DateTime?
  /// Payer-side recurring-charge receipt one-shot stamp.
  customerNotifiedAt DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  subscription      Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  merchant          Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction       Transaction?

  @@index([subscriptionId, attemptNumber])
  @@index([status, scheduledAt])
  /// Drives the recurring-charge notification cron.
  @@index([status, merchantNotifiedAt])
  @@index([status, customerNotifiedAt])
}
