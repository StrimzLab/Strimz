// Platform-operator users. Strimz-internal staff who log in to the
// `/admin` surface to manage merchants, see platform-wide analytics,
// and run write actions like suspend / change-tier.
//
// AdminUser is intentionally separate from Merchant. A Strimz operator
// might happen to have a Merchant row too (we eat our own dog food),
// but the auth surfaces are independent — `MerchantAuthGuard` looks at
// `Merchant.privyUserId`, `AdminAuthGuard` looks at
// `AdminUser.privyUserId`. The two can be the same Privy user without
// collision.

model AdminUser {
  id          String          @id @default(cuid())
  /// Privy DID, claimed on first login via the email match below.
  /// Null only between bootstrap (a row inserted by migration with
  /// just an email) and the operator's first sign-in.
  privyUserId String?         @unique
  email       String          @unique @db.VarChar(320)
  name        String?         @db.VarChar(120)
  role        AdminRole
  status      AdminUserStatus @default(active)
  /// AdminUser.id of the operator who issued this invite. Null for
  /// the bootstrap super_admin (no one to attribute that to).
  invitedById String?
  invitedAt   DateTime        @default(now())
  lastLoginAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  invitedBy       AdminUser?         @relation("AdminUserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invited         AdminUser[]        @relation("AdminUserInvites")
  broadcastsSent  AdminBroadcast[]   @relation("AdminBroadcastSender")

  @@index([role])
  @@index([status])
}
