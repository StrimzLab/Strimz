// Merchant-initiated refunds.
// Refund execution is a merchant-signed on-chain transfer; Strimz records
// intent and reconciles via the resulting transaction.

model Refund {
  id              String        @id @default(cuid())
  merchantId      String
  transactionId   String

  amount          String        @db.VarChar(78)
  currency        PaymentCurrency
  reason          RefundReason
  note            String?       @db.VarChar(500)
  status          RefundStatus  @default(pending)
  payerAddress    String        @db.VarChar(42)
  refundTxHash    String?       @unique @db.VarChar(66)
  failureReason   String?       @db.VarChar(500)
  initiatedById   String

  mode            Mode          @default(test)
  metadata        Json          @default("{}")
  /// Payer-side refund receipt one-shot stamp.
  customerNotifiedAt DateTime?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction     Transaction?

  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@index([status, customerNotifiedAt])
}
