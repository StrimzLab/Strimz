// Shareable invoices with structured line items.
// Line items are stored as JSON on the Invoice row (no separate table) —
// they are immutable once the invoice is sent.

model Invoice {
  id            String          @id @default(cuid())
  merchantId    String
  number        String          @db.VarChar(40)
  customerName  String?         @db.VarChar(200)
  customerEmail String?         @db.VarChar(320)
  /// Array of { description, quantity, unitAmount } objects.
  lineItems     Json
  subtotal      String          @db.VarChar(78)
  total         String          @db.VarChar(78)
  currency      PaymentCurrency
  status        InvoiceStatus   @default(draft)
  note          String?         @db.VarChar(2000)
  sessionId     String?         @unique

  mode Mode @default(test)

  dueAt     DateTime
  paidAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  session  PaymentSession? @relation("InvoiceSession", fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([merchantId, number])
  @@index([merchantId, status])
  @@index([merchantId, dueAt])
}
