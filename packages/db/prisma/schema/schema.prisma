// Strimz platform database schema.
//
// This is the root Prisma file — it holds the generator and datasource.
// Models and enums are split into domain-specific files in this folder.
// All .prisma files under `prisma/schema/` are merged at generate time.

generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"

  // Emit ESM-friendly output that compiles cleanly under our consumer
  // tsconfigs (apps use `module: "Node16"` / `moduleResolution: "Node16"`,
  // which requires explicit `.js` extensions on relative imports).
  // `importFileExtension = "js"` turns Prisma's emitted `from "./enums"`
  // into `from "./enums.js"` so the generated client passes strict
  // module resolution. Without these the `@ts-nocheck` directive Prisma
  // adds defensively was the only thing keeping consumer builds green —
  // at the cost of model accessors silently degrading to `any`.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
