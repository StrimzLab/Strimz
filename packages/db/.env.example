# Copy this file to .env for local Prisma CLI use.
# Apps (api, scheduler, agent, indexer) read their own DATABASE_URL from
# their own env — this one is only consumed by the Prisma CLI during
# generate / migrate / studio.

DATABASE_URL="postgresql://strimz:strimz@localhost:5432/strimz?schema=public"

# Optional: force the Prisma migration engine to use the shadow DB over a
# non-default URL. Not needed for local Docker Compose development.
# SHADOW_DATABASE_URL="postgresql://strimz:strimz@localhost:5432/strimz_shadow?schema=public"
