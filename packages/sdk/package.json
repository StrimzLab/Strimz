{
  "name": "@strimz/sdk",
  "version": "0.1.1",
  "description": "The Strimz SDK. Typed client for server and edge runtimes. Handles HTTP, retries, idempotency, pagination, EIP-712 typed-data building, and webhook signature verification.",
  "license": "MIT",
  "author": "Strimz <hello@strimz.finance>",
  "homepage": "https://github.com/StrimzLab/strimz/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StrimzLab/strimz.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/StrimzLab/strimz/issues"
  },
  "keywords": [
    "strimz",
    "billing",
    "subscriptions",
    "usdc",
    "stablecoin",
    "arc",
    "sdk",
    "eip-3009",
    "eip-2612",
    "eip-712",
    "payments"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser-client.d.ts",
      "import": "./dist/browser-client.js",
      "require": "./dist/browser-client.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./eip712": {
      "types": "./dist/eip712.d.ts",
      "import": "./dist/eip712.js",
      "require": "./dist/eip712.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@strimz/shared-config": "workspace:*",
    "@strimz/shared-crypto": "workspace:*",
    "@strimz/shared-types": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@strimz/eslint-config": "workspace:*",
    "@strimz/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
