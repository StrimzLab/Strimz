{
  "name": "@strimz/sdk-react",
  "version": "0.1.1",
  "description": "Strimz React components and hooks. Drop-in <StrimzPayButton/>, embedded checkout, typed hooks, and a context provider for the Strimz API.",
  "license": "MIT",
  "author": "Strimz <hello@strimz.finance>",
  "homepage": "https://github.com/StrimzLab/strimz/tree/main/packages/sdk-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StrimzLab/strimz.git",
    "directory": "packages/sdk-react"
  },
  "bugs": {
    "url": "https://github.com/StrimzLab/strimz/issues"
  },
  "keywords": [
    "strimz",
    "react",
    "checkout",
    "usdc",
    "stablecoin",
    "arc",
    "billing",
    "components",
    "hooks"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@strimz/sdk": "workspace:*",
    "@strimz/shared-config": "workspace:*",
    "@strimz/shared-types": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@strimz/eslint-config": "workspace:*",
    "@strimz/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
