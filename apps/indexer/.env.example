# Strimz indexer — environment template.
# Copy to `.env` and fill in.

ARC_ENVIRONMENT=testnet
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.io
# Optional ordered fallback endpoints, comma-separated. Tried in order when
# ARC_RPC_URL errors.
ARC_FALLBACK_RPC_URLS=https://rpc.quicknode.testnet.arc.io,https://rpc.blockdaemon.testnet.arc.io
# The indexer's own endpoints. When set they replace the two above, so the API and
# scheduler can use keyed RPCs with small log ranges. Every indexer endpoint must
# answer eth_getLogs over BLOCK_BATCH_SIZE blocks, or boot stops.
INDEXER_ARC_RPC_URL=
INDEXER_FALLBACK_RPC_URLS=
DATABASE_URL=

LOG_LEVEL=info
HTTP_PORT=4100
# Arc blocks are sub-second; deterministic finality means no reorgs.
POLL_INTERVAL_MS=1000
CONFIRMATIONS=1
START_BLOCK=74376690
BLOCK_BATCH_SIZE=500

# Strimz contract addresses on Arc — emitted by Foundry deployment.
REGISTRY_ADDRESS=
PAYMENTS_ADDRESS=
SUBSCRIPTIONS_ADDRESS=
# Both agent addresses or neither; empty on mainnet (no agent contracts there).
AGENT_ESCROW_ADDRESS=
FEE_COLLECTOR_ADDRESS=
TOKEN_WHITELIST_ADDRESS=
AGENT_REGISTRY_ADDRESS=
TIMELOCK_ADDRESS=

# Stablecoin addresses to scan for refund-completion ERC-20 Transfers.
# Comma-separated.
STABLECOIN_ADDRESSES=USDC:0x3600000000000000000000000000000000000000,EURC:0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
