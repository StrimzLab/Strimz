# Strimz indexer — environment template.
# Copy to `.env` and fill in.

ARC_ENVIRONMENT=testnet
ARC_RPC_URL=https://rpc.arc-testnet.example.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strimz?schema=public

LOG_LEVEL=info
HTTP_PORT=4100
POLL_INTERVAL_MS=5000
CONFIRMATIONS=5
START_BLOCK=0
BLOCK_BATCH_SIZE=500

# Strimz contract addresses on Arc — emitted by Foundry deployment.
REGISTRY_ADDRESS=
PAYMENTS_ADDRESS=
SUBSCRIPTIONS_ADDRESS=
AGENT_ESCROW_ADDRESS=
FEE_COLLECTOR_ADDRESS=

# Stablecoin addresses to scan for refund-completion ERC-20 Transfers.
# Comma-separated.
STABLECOIN_ADDRESSES=
