# Strimz AutoPay Agent — environment template.

NODE_ENV=development
PORT=4300
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strimz?schema=public
REDIS_URL=redis://localhost:6379

ARC_ENVIRONMENT=testnet
ARC_RPC_URL=https://rpc.arc-testnet.example.com

# Cron schedules — node-cron syntax (sec min hour day month wday)
RECOVERY_TICK_CRON=0 0 * * * *                  # hourly
CASHFLOW_DIGEST_CRON=0 0 9 * * *                # 9am UTC daily
CASHFLOW_ANOMALY_CRON=0 0 * * * *               # hourly
CASHFLOW_YIELD_CRON=0 30 9 * * *                # 9:30am UTC daily
COMMERCE_MONTHLY_CRON=0 0 9 1 * *               # 9am on the 1st of each month
PRICING_MONTHLY_CRON=0 0 9 1 * *                # 9am on the 1st of each month

# Anomaly thresholds (standard deviations from trailing-30d hourly average)
ANOMALY_THRESHOLD_LOW=3.0
ANOMALY_THRESHOLD_MEDIUM=2.0
ANOMALY_THRESHOLD_HIGH=1.0

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@strimz.io

# Circle CCTP V2 — used by the routing capability to fetch attestations.
# testnet  https://iris-api-sandbox.circle.com
# mainnet  https://iris-api.circle.com
CIRCLE_ATTESTATION_BASE_URL=https://iris-api-sandbox.circle.com
CIRCLE_API_KEY=
