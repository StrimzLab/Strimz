{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "strimz-checkout",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  // esbuild's keep_names wraps functions in __name(), which breaks inline <script>s.
  "keep_names": false,
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "strimz-checkout" }],
  "env": {
    // Test mode on Arc testnet, deployed with `--env test`.
    "test": {
      "name": "strimz-checkout-test",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "strimz-checkout-test" }],
    },
  },
}
