# Strimz hosted checkout and storefronts (checkout.strimz.finance).

# This app's own origin; wallet apps show it to the payer.
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where each Strimz web app lives (ADR-2026-11-14-split-web-into-workers).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_CHECKOUT_URL=http://localhost:3002
NEXT_PUBLIC_DOCS_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_URL=http://localhost:3004

# Arc chain
NEXT_PUBLIC_ARC_ENVIRONMENT=testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# Wallet connect
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Publishable key (pk_test_... or pk_live_...) for the SDK's public endpoints.
NEXT_PUBLIC_STRIMZ_PUBLISHABLE_KEY=

# Contract addresses on the active chain: the payment's `to` and the
# subscription's `spender`. USDC on Arc testnet is the reserved 0x3600… address.
NEXT_PUBLIC_STRIMZ_PAYMENTS_ADDRESS=
NEXT_PUBLIC_STRIMZ_SUBSCRIPTIONS_ADDRESS=
NEXT_PUBLIC_STRIMZ_USDC_ADDRESS=0x3600000000000000000000000000000000000000
