# Fanline demo dApp — env template.

# --- Strimz API ---
# Base URL of the Strimz API. Local dev = http://localhost:4000.
STRIMZ_API_URL=http://localhost:4000

# Secret key issued to the demo merchant by `pnpm --filter @strimz/api seed:test-merchant`.
# The seed script prints this once — never recoverable — paste it here.
STRIMZ_SECRET_KEY=sk_live_REPLACE_ME

# Publishable key (browser-safe). Same seed script prints this too.
# Used by @strimz/sdk-react on the client side. Scope: read-only public
# catalog endpoints; safe to inline into the JS bundle.
NEXT_PUBLIC_STRIMZ_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# --- Hosted checkout ---
# Origin of the Strimz web app. The dApp's client-side code redirects
# users here to complete payments. Local dev = http://localhost:3000.
NEXT_PUBLIC_STRIMZ_CHECKOUT_ORIGIN=http://localhost:3000

# --- Fanline (this app) URLs ---
# Where the Fanline landing page lives. Used to build return URLs
# sent to Strimz hosted checkout.
NEXT_PUBLIC_FANLINE_URL=http://localhost:3200
