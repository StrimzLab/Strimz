# Copy to .env for local development.

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
API_BASE_URL=http://localhost:4000
CHECKOUT_ORIGIN=http://localhost:3000

# Database (shared with @strimz/db; same instance is OK in dev)
DATABASE_URL=

# Redis (used for BullMQ queues, rate-limit buckets, idempotency cache)
REDIS_URL=redis://localhost:6379

# Privy — merchant dashboard auth
# Get these from the Privy dashboard: https://dashboard.privy.io/
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional — only required when using Privy's JWKS-style verification key
# PRIVY_VERIFICATION_KEY=

# Cloudflare Turnstile — bot protection on signup
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# Webhook signing
STRIMZ_WEBHOOK_SIGNING_SECRET=replace-me-with-openssl-rand-hex-32

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@strimz.io

# Arc chain
ARC_ENVIRONMENT=testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
STRIMZ_REGISTRY_ADDRESS=
STRIMZ_PAYMENTS_ADDRESS=
STRIMZ_SUBSCRIPTIONS_ADDRESS=
STRIMZ_FEE_COLLECTOR_ADDRESS=
STRIMZ_TOKEN_WHITELIST_ADDRESS=

# Compliance (TRM Labs / Elliptic). Use `disabled` in dev / testnet.
COMPLIANCE_PROVIDER=disabled
COMPLIANCE_API_KEY=
COMPLIANCE_BLOCK_THRESHOLD=80

# KMS — signing key for the meta-tx relayer.
# `software` keeps the key in process memory; appropriate for dev,
# testnet, and early production (the relayer can only spend its own
# gas balance — it cannot steal merchant or payer funds).
KMS_PROVIDER=software
# 0x-prefixed 32-byte hex private key for the software signer.
# - Dev/CI: leave empty; an ephemeral key is generated at boot and the
#   derived address is logged so you can fund it from the Arc faucet.
# - Production: REQUIRED. Set this in your hosting provider's encrypted
#   secrets vault (`fly secrets set`, Vercel/Railway dashboard, etc.) —
#   NEVER commit. The boot guard refuses to start in production without
#   an explicit key.
# Generate with:  node -e "console.log(require('viem/accounts').generatePrivateKey())"
KMS_SOFTWARE_PRIVATE_KEY=

# Sentry (optional in dev)
SENTRY_DSN=

# CORS
CORS_ORIGIN=http://localhost:3000
