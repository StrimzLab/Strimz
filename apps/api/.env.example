# Copy to .env for local development.

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
API_BASE_URL=http://localhost:4000
CHECKOUT_ORIGIN=http://localhost:3000

# Database (shared with @strimz/db; same instance is OK in dev)
DATABASE_URL=

# Redis (used for BullMQ queues, rate-limit buckets, idempotency cache)
REDIS_URL=redis://localhost:6379

# Privy — merchant dashboard auth
# Get these from the Privy dashboard: https://dashboard.privy.io/
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional — only required when using Privy's JWKS-style verification key
# PRIVY_VERIFICATION_KEY=

# Cloudflare Turnstile — bot protection on signup
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# Webhook signing
STRIMZ_WEBHOOK_SIGNING_SECRET=replace-me-with-openssl-rand-hex-32

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@strimz.io

# Arc chain
ARC_ENVIRONMENT=testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
STRIMZ_REGISTRY_ADDRESS=
STRIMZ_PAYMENTS_ADDRESS=
STRIMZ_SUBSCRIPTIONS_ADDRESS=
STRIMZ_FEE_COLLECTOR_ADDRESS=
STRIMZ_TOKEN_WHITELIST_ADDRESS=

# Compliance (TRM Labs / Elliptic). Use `disabled` in dev / testnet.
COMPLIANCE_PROVIDER=disabled
COMPLIANCE_API_KEY=
COMPLIANCE_BLOCK_THRESHOLD=80

# Sentry (optional in dev)
SENTRY_DSN=

# CORS
CORS_ORIGIN=http://localhost:3000
