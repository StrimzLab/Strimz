{
  "name": "@strimz/api",
  "version": "0.0.0",
  "private": true,
  "description": "Strimz HTTP API — NestJS + Fastify. Auth, merchants, sessions, subscriptions, refunds, webhooks, compliance, analytics, agents, storefronts, invoices.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "DOCKER_HOST=${DOCKER_HOST:-unix://${HOME}/.docker/run/docker.sock} vitest run --config vitest.e2e.config.ts",
    "seed:test-merchant": "node --env-file=.env scripts/seed-test-merchant.mjs",
    "e2e:checkout-payment": "node --env-file=.env scripts/e2e-checkout-payment.mjs",
    "e2e:checkout-subscription": "node --env-file=.env scripts/e2e-checkout-subscription.mjs",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@nestjs/common": "^11.0.4",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.4",
    "@nestjs/platform-fastify": "^11.0.4",
    "@nestjs/swagger": "^11.0.3",
    "@privy-io/server-auth": "^1.18.7",
    "@scalar/fastify-api-reference": "^1.59.2",
    "@strimz/chain-adapter": "workspace:*",
    "@strimz/chain-adapter-evm": "workspace:*",
    "@strimz/db": "workspace:*",
    "@strimz/email-templates": "workspace:*",
    "@strimz/sdk": "workspace:*",
    "@strimz/shared-config": "workspace:*",
    "@strimz/shared-crypto": "workspace:*",
    "@strimz/shared-types": "workspace:*",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.3.0",
    "nestjs-zod": "^4.3.1",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "rxjs": "^7.8.1",
    "viem": "^2.22.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.4",
    "@strimz/eslint-config": "workspace:*",
    "@strimz/tsconfig": "workspace:*",
    "@swc/core": "^1.10.7",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
