# Strimz web app — environment template.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth (merchant dashboard)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Wallet connect (checkout)
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Arc chain
NEXT_PUBLIC_ARC_ENVIRONMENT=testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.arc-testnet.example.com

# Strimz publishable key — `pk_test_...` or `pk_live_...`. Used by the
# browser to call public SDK endpoints (session retrieval, token metadata).
NEXT_PUBLIC_STRIMZ_PUBLISHABLE_KEY=

# Strimz contract addresses on the active chain. The browser reads
# these to build the EIP-3009 `to` field for one-shot payments and the
# EIP-2612 `spender` field for subscription enrolments. Match against
# the addresses logged at backend `DeployCore` time.
NEXT_PUBLIC_STRIMZ_PAYMENTS_ADDRESS=
NEXT_PUBLIC_STRIMZ_SUBSCRIPTIONS_ADDRESS=

# USDC token on the active chain. Arc Testnet ships USDC at the
# protocol-reserved 0x3600… address. Other tokens are looked up by
# their on-chain address; this default seeds the v1 demo flows.
NEXT_PUBLIC_STRIMZ_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ---- Stellar onboarding (M3) ----
# Network the merchant's passkey-derived smart wallet will deploy on.
# `testnet` derives addresses bound to the Stellar test network passphrase;
# `pubnet` for mainnet. The wallet address is computed deterministically
# from (deployer, credential id, passphrase) at enrolment time.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Strimz operator G-account that deploys merchant smart wallets on
# Stellar. One per network. Funded by Strimz so the merchant doesn't
# pay an account-creation reserve. The wallet contract is deployed
# lazily on the first incoming payment (M5).
NEXT_PUBLIC_STELLAR_DEPLOYER_ADDRESS=

# ---- Server-only (never NEXT_PUBLIC_) ----
# Strimz internal API key used by the checkout BFF route handlers
# (apps/web/src/app/api/checkout/...) to submit relay txs on behalf
# of the payer. Holds `relay_write` + `relay_read` scopes. Never
# expose to the browser; only Next.js server-side code reads it.
STRIMZ_INTERNAL_API_KEY=
