# Strimz merchant dashboard (app.strimz.finance).

NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PRIVY_APP_ID=

# Where each Strimz web app lives (ADR-2026-11-14-split-web-into-workers).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_CHECKOUT_URL=http://localhost:3002
NEXT_PUBLIC_DOCS_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_URL=http://localhost:3004

# Arc chain
NEXT_PUBLIC_ARC_ENVIRONMENT=testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# Publishable key (pk_test_... or pk_live_...) for the SDK's public endpoints.
NEXT_PUBLIC_STRIMZ_PUBLISHABLE_KEY=

# ---- Server-only (never NEXT_PUBLIC_) ----
# UploadThing v7 token for /api/uploadthing (storefront logo, cover, product images).
UPLOADTHING_TOKEN=
