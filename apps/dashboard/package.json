{
  "name": "@strimz/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "dev": "next dev --port 3001",
    "start": "next start --port 3001",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .next .open-next .turbo *.tsbuildinfo",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@iconify-icons/solar": "2.0.4",
    "@iconify/react": "6.0.2",
    "@privy-io/react-auth": "3.51.3",
    "@react-pdf/renderer": "^4.5.1",
    "@strimz/sdk": "workspace:*",
    "@strimz/sdk-react": "workspace:*",
    "@strimz/shared-config": "workspace:*",
    "@strimz/shared-types": "workspace:*",
    "@strimz/ui": "workspace:*",
    "@strimz/web-shared": "workspace:*",
    "@tanstack/react-query": "^5.62.16",
    "@tanstack/react-table": "^8.21.3",
    "@uploadthing/react": "^7.3.3",
    "date-fns": "^4.1.0",
    "driver.js": "^1.6.0",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.29",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "uploadthing": "^7.7.4",
    "viem": "^2.45.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "^1.49.1",
    "@strimz/eslint-config": "workspace:*",
    "@strimz/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "4.154.0"
  }
}
